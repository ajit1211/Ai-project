# NEXA local development settings.
# Copy to .env for local use. Never commit .env. Values here are local-only placeholders.

NEXA_ENV=development
LOG_LEVEL=INFO
# Human-readable logs locally; JSON everywhere else.
LOG_JSON=false

# PostgreSQL: two roles enforce per-table write ownership (architecture doc 11.3).
# Created by scripts/db/init.sql.
DATABASE_URL=postgresql://nexa_core:nexa_core_dev@localhost:5432/nexa
RUNTIME_DATABASE_URL=postgresql://nexa_runtime:nexa_runtime_dev@localhost:5432/nexa

# Redis: queue/pub-sub and cache are separate instances in production;
# locally they share one server on different logical databases.
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# FastAPI (Runtime): where Core publishes its JWT verification keys.
CORE_JWKS_URL=http://localhost:8000/.well-known/jwks.json

# Django (Core)
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# AI Gateway (docs/architecture/ai-gateway.md). Keys are optional: without them the
# development stack answers from the deterministic mock provider. Never commit real keys.
# AI_ANTHROPIC_API_KEY=
# AI_OPENAI_API_KEY=
# The mock provider is on in development and test only; it cannot be enabled elsewhere.
# AI_MOCK_PROVIDER=true
# Timeouts in seconds and platform default limits; see RuntimeSettings for the full list.
# AI_TIMEOUT_TOTAL=300
# AI_ORG_TOKENS_PER_DAY=2000000
# AI_USER_TOKENS_PER_DAY=500000
