# NEXA local development settings.
# Copy to .env for local use. Never commit .env. Values here are local-only placeholders.

NEXA_ENV=development
LOG_LEVEL=INFO
# Human-readable logs locally; JSON everywhere else.
LOG_JSON=false

# PostgreSQL: two roles enforce per-table write ownership (architecture doc 11.3).
# Created by scripts/db/init.sql.
DATABASE_URL=postgresql://nexa_core:nexa_core_dev@localhost:5432/nexa
RUNTIME_DATABASE_URL=postgresql://nexa_runtime:nexa_runtime_dev@localhost:5432/nexa

# Redis: queue/pub-sub and cache are separate instances in production;
# locally they share one server on different logical databases.
REDIS_QUEUE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# FastAPI (Runtime): where Core publishes its JWT verification keys.
CORE_JWKS_URL=http://localhost:8000/.well-known/jwks.json

# Django (Core)
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Documents (docs/architecture/documents.md). Files are stored privately under
# .local/documents (git-ignored); limits apply per file, per user and per organization.
# DOCUMENTS_STORAGE_ROOT=.local/documents
# DOCUMENTS_MAX_UPLOAD_BYTES=52428800
# DOCUMENTS_MAX_TEXT_CHARS=5000000
# DOCUMENTS_MAX_PAGES=500
# DOCUMENTS_MAX_CSV_ROWS=50000
# DOCUMENTS_PROCESSING_TIMEOUT_SECONDS=600
# DOCUMENTS_MAX_ATTEMPTS=5
# DOCUMENTS_UPLOADS_PER_HOUR=60
# DOCUMENTS_ORG_STORAGE_BYTES=5368709120
# DOCUMENTS_PURGE_AFTER_DAYS=30

# Document search index and grounded answers (docs/architecture/rag.md). Sizes are characters;
# tokens are estimated at three characters each. Core (indexing):
# RAG_CHUNK_TARGET_CHARS=1200
# RAG_CHUNK_MAX_CHARS=2000
# RAG_CHUNK_OVERLAP_CHARS=200
# RAG_MAX_CHUNKS_PER_DOCUMENT=20000
# RAG_INDEX_TIMEOUT_SECONDS=300
# RAG_INDEX_REQUESTS_PER_HOUR=30
# Runtime (retrieval and answers):
# RAG_ENABLED=true
# RAG_TOP_K=6
# RAG_MAX_TOP_K=12
# RAG_CONTEXT_MAX_TOKENS=3000
# RAG_RETRIEVAL_TIMEOUT_MS=5000
# RAG_MAX_QUESTION_CHARS=4000
# RAG_QUERIES_PER_MINUTE=20

# Semantic search (docs/architecture/vector-search.md): embeddings with pgvector. Document text
# and questions are sent to the embedding provider; EMBEDDING_ENABLED=false (in both Core and
# Runtime) keeps them on the server and answers by keywords. Keep both services' values equal.
# EMBEDDING_ENABLED=true
# An embedding model key (e.g. nexa-embed-small); empty uses the registry's default.
# EMBEDDING_MODEL=
# Core (document embeddings):
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_MAX_BATCH_TOKENS=100000
# EMBEDDING_TIMEOUT_SECONDS=30
# EMBEDDING_MAX_ATTEMPTS=3
# EMBEDDING_TASK_RETRIES=3
# EMBEDDING_JOB_TIMEOUT_SECONDS=900
# EMBEDDING_ORG_TOKENS_PER_DAY=2000000
# Runtime (retrieval): what "auto" means (lexical, semantic or hybrid), and fusion settings.
# RAG_RETRIEVAL_MODE=hybrid
# RAG_VECTOR_CANDIDATES=40
# RAG_RRF_K=60
# RAG_QUERY_EMBEDDING_TIMEOUT_SECONDS=10
# RAG_HNSW_EF_SEARCH=100
# RAG_SEMANTIC_STATUS_TTL_SECONDS=30

# AI Gateway (docs/architecture/ai-gateway.md). Keys are optional: without them the
# development stack answers from the deterministic mock provider. Never commit real keys.
# AI_ANTHROPIC_API_KEY=
# AI_OPENAI_API_KEY=
# Also used by Core for document embeddings (and by Runtime for questions).
# AI_OPENAI_BASE_URL=
# The mock provider is on in development and test only; it cannot be enabled elsewhere.
# AI_MOCK_PROVIDER=true
# Timeouts in seconds and platform default limits; see RuntimeSettings for the full list.
# AI_TIMEOUT_TOTAL=300
# AI_ORG_TOKENS_PER_DAY=2000000
# AI_USER_TOKENS_PER_DAY=500000
